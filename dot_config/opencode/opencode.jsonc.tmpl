{{- $workAgents := "" -}}
{{- if and .enableWorkDotfiles (ne .extraWorkDotfilesRepoPath "") -}}
{{-   if hasSuffix ".git" .extraWorkDotfilesRepoPath -}}
{{-     $workAgents = joinPath .chezmoi.homeDir "dotfiles/.config/opencode/AGENTS.md" -}}
{{-   else -}}
{{-     $workAgents = joinPath .extraWorkDotfilesRepoPath ".config/opencode/AGENTS.md" -}}
{{-   end -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
{{- if $workAgents }}
  "instructions": [{{ $workAgents | toJson }}],
{{- end }}
  "mcp": {
    "Jira": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "oauth": {}
    }
  },
  "permission": {
    "external_directory": {
      "~/dev/project-neptune/**": "allow",
      "~/.kube/configs/**": "allow",
      "~/go/pkg/**": "allow",
      "/opt/homebrew/bin/**": "allow",
      "/usr/local/bin/**": "allow",
      "~/.config/**": "allow",
      "~/.local/share/**": "allow"
    },
    "read": {
      "~/go/pkg/**": "allow",
      "/opt/homebrew/bin/**": "allow",
      "/usr/local/bin/**": "allow",
      "~/.config/**": "allow",
      "~/.local/share/**": "allow"
    },
    "edit": {
      "*": "allow",
      "~/go/pkg/**": "deny",
      "/opt/homebrew/bin/**": "deny",
      "/usr/local/bin/**": "deny",
      "~/.config/**": "deny",
      "~/.local/share/**": "deny"
    }
  }
}
