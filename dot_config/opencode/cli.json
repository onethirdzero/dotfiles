{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "permissions": "prompt",
    "verbosity": "low"
  },
  "animations": true,
  "theme": {
    "name": "everforest"
  },
  "tabs": {
    "mode": "off",
    "indicators": "status"
  },
  "scroll": {
    "acceleration": true,
    "speed": 1
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "terminal": {
    "copy": "select"
  }
}
