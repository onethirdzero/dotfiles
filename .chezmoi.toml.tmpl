{{- $email := promptString "main email for Git on this computer" -}}
{{- $name := promptString "name for Git on this computer" -}}
{{- $gitSSHSigningKeyPath := promptString "absolute path to git SSH signing pub key (don't use ~ or variables)" -}}
{{- $isPersonalMachine := promptBool "Is this a personal machine (y/n)" -}}
{{- $enableWorkDotfiles := promptBool "Enable work dotfiles (y/n)" -}}
{{- $extraWorkDotfilesRepoPath := promptString "local absolute path or SSH URL to an additional work dotfiles repo, for sensitive data that should not be committed to this repo (optional)" -}}

[data]
    email = {{ $email | quote }}
    name = {{ $name | quote }}

    isPersonalMachine = {{ $isPersonalMachine }}
    enableWorkDotfiles = {{ $enableWorkDotfiles }}
    extraWorkDotfilesRepoPath = {{ $extraWorkDotfilesRepoPath | quote }}
    gitSSHSigningKeyPath = {{ $gitSSHSigningKeyPath | quote }}
